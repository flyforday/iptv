// Même déploiement que ../wrangler.jsonc, si Cloudflare est réglé sur le dossier « web ».
{
  "name": "iptv",
  "main": "../worker/index.js",
  "compatibility_date": "2026-10-01",
  // Depuis les centres Cloudflare de France, le fournisseur met ~20 s à
  // répondre ; depuis les États-Unis, moins d'une demi-seconde.
  "placement": { "region": "aws:us-east-1" },
  "assets": { "directory": ".", "binding": "ASSETS" }
}
